{
  "name": "reviewmetric-mcp",
  "version": "1.1.0",
  "tools": [
    {
      "name": "submit_manuscript",
      "description": "Submit a local .docx manuscript to the ReviewMetric review panel (uses 1 RM token).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "file_path": {
            "type": "string",
            "description": "Absolute path to the .docx file."
          }
        },
        "required": [
          "file_path"
        ]
      }
    },
    {
      "name": "check_analysis_status",
      "description": "Progress of a review, or the full report when it is done.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "description": "Run ID from submit_manuscript."
          }
        },
        "required": [
          "run_id"
        ]
      }
    },
    {
      "name": "get_report_json",
      "description": "Complete report as JSON for a finished review.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "run_id": {
            "type": "string",
            "description": "Run ID of a completed review."
          }
        },
        "required": [
          "run_id"
        ]
      }
    }
  ],
  "prompts": [],
  "resources": []
}